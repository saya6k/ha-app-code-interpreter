#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Announces the MCP endpoint to Home Assistant via Supervisor discovery.
# Runs as a oneshot after mcp-server, and never fails the container: a failed
# announce is a degraded state (add the endpoint manually in HA), not a broken
# app.
# ==============================================================================
set -uo pipefail

# s6 only orders process start, not readiness — wait for the server to listen
# (its startup sandbox self-check runs first) so the announced URL answers the
# moment HA validates it.
for _ in $(seq 1 240); do
    if (exec 3<>/dev/tcp/127.0.0.1/8099) 2>/dev/null; then
        exec 3<&-
        break
    fi
    sleep 0.5
done

# Skipped silently when no Supervisor is present (bare docker smoke tests).
if ! bashio::supervisor.ping 2>/dev/null; then
    bashio::log.info "No Supervisor detected — skipping discovery announce."
    exit 0
fi

# The MCP server writes its token before it listens; Home Assistant sends it
# back as a bearer token on every request (2026.12+).
token=$(cat /data/mcp_token 2>/dev/null || true)
if [ -z "${token}" ]; then
    # Without it Home Assistant would store no token and every call would be refused.
    bashio::log.warning "MCP server did not start; not announcing. Restart the app."
    exit 0
fi
if bashio::discovery "mcp" "{\"url\": \"http://$(hostname):8099/mcp\", \"token\": \"${token}\"}" > /dev/null; then
    bashio::log.info "Announced MCP endpoint to Home Assistant."
else
    bashio::log.warning "Supervisor discovery announce failed (non-fatal)."
    bashio::log.warning "Restart the app to announce it again; Home Assistant must find it through discovery."
fi

exit 0
